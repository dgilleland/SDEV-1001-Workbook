# General folders for non-trackable info
[Nn]o[Tt]rack/
[Rr]n[Dd]/

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/

# Python tooling and generated packaging files
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/
.ipynb_checkpoints/
.python_history

# Local environment variables (keep example configuration trackable)
.env
.env.*
!.env.example

# Editor-local files (shared VS Code configuration stays trackable)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
.history/
*.swp
*.swo
*~

# Operating-system clutter
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.Trash-*/

# Instructor patches, captures, and archives
[Ww]orkbook*.patch
*.snag
*.snagx
*.zip
*.zipx
*.7z
*.rar
*.tar
*.gz
*.tgz

# Temporary files and Office lock files
*.tmp
~$*
